{
  "name": "sf-game",
  "version": "0.1.0",
  "private": true,
  "description": "โป๊ะแตก — เว็บเกมแนว Bluff เล่นต่อหน้ากัน (มือถือเป็นตัวช่วย)",
  "engines": {
    "node": ">=20"
